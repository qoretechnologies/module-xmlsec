#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# The file operations of the xmlsec module are checked against the filesystem policy of the code that calls them;
# code run with the system policy (SandboxManager::createSystemPolicyCall()) is checked against the system policy.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires QUnit
%requires Util
%requires FsUtil
%requires xmlsec

%exec-class XmlSecSandboxTest

class XmlSecSandboxTest inherits QUnit::Test {
    private {
        #! the test directory
        string dir;
    }

    constructor() : QUnit::Test("xmlsec sandbox", "1.0", \ARGV) {
        addTestCase("file operations follow the sandbox of the caller and the system policy in a capability",
            \testFiles());
        set_return_value(main());
    }

    globalSetUp() {
        dir = make_tmp_dir("qore-xmlsec-sandbox-");
    }

    globalTearDown() {
        remove_tree(dir);
    }

    #! returns a Program whose sandbox denies the filesystem
    private Program getSandboxed() {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(sm);
        p.parse("auto sub through(code c) { return c(); }", "xmlsec-sandbox");
        return p;
    }

    #! runs an operation directly from the sandbox, where it is denied, then in a capability, where it runs
    private auto check(Program p, string name, code op) {
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("through", op),
            name + " called directly from the sandbox is denied");
        return p.callFunction("through", SandboxManager::createSystemPolicyCall(op));
    }

    testFiles() {
        Program p = getSandboxed();
        string cert = get_script_dir() + DirSep + "test-cert.pem";

        check(p, "XmlSecKeyManager::loadCertFromPath()", sub () {
            XmlSecKeyManager mgr();
            mgr.loadCertFromPath(cert, xmlSecKeyDataFormatCertPem, xmlSecKeyDataTypeTrusted);
        });
    }
}
